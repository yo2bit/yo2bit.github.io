---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <div class="max-w-2xl mx-auto p-6 min-h-screen bg-black text-white">
    <h1 class="text-3xl font-bold mb-6">Blog</h1>
    
    <div class="flex flex-col gap-4">
      {posts.map((post) => (
        <a 
          href={`/blog/${post.id}/`} 
          class="block p-5 border border-zinc-800 rounded-lg bg-zinc-900 hover:border-zinc-700 transition"
        >
          <h2 class="text-xl font-semibold text-white mb-2">{post.data.title}</h2>
          <time class="text-sm text-zinc-400 block mb-2">
            {post.data.pubDate.toLocaleDateString()}
          </time>
          {post.data.description && (
            <p class="text-zinc-300 text-sm">{post.data.description}</p>
          )}
        </a>
      ))}
    </div>
  </div>
</Layout>