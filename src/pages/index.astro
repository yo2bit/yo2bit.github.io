---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="flex flex-col items-center justify-center min-h-screen bg-black text-white font-sans">
    <img 
      src="/avatar.png" 
      alt="yo2bit avatar" 
      width="150" 
      height="150" 
      class="rounded-full object-cover" 
      loading="lazy" 
    />

    <h1 class="text-6xl font-bold my-8">yo2bit</h1>

    <div class="flex gap-8">
      <a 
        href="https://github.com/yo2bit" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-white text-lg no-underline hover:text-zinc-400 transition"
      >
        GitHub
      </a>
      <a 
        href="https://x.com/yo2bit" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-white text-lg no-underline hover:text-zinc-400 transition"
      >
        X
      </a>
      <a 
        href="/blog" 
        class="text-white text-lg no-underline hover:text-zinc-400 transition"
      >
        Blog
      </a>
    </div>
  </div>
</Layout>
