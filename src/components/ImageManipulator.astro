---
/**
 * ImageManipulator Component
 * 
 * Performs custom distance pixel swap followed by logarithmic intensity transformation
 * Supports three patterns: reverse, shift, jump
 * Supports three directions: horizontal, vertical, both (2D block grid)
 */

let fileInputEl: HTMLInputElement | null = null;
let dropZoneEl: HTMLDivElement | null = null;
let swapDistEl: HTMLInputElement | null = null;
let distValEl: HTMLSpanElement | null = null;
let swapPatternEl: HTMLSelectElement | null = null;
let swapModeEl: HTMLSelectElement | null = null;
let logScaleEl: HTMLInputElement | null = null;
let scaleValEl: HTMLSpanElement | null = null;
let swapDescEl: HTMLDivElement | null = null;
let originalViewEl: HTMLImageElement | null = null;
let swapCanvasEl: HTMLCanvasElement | null = null;
let logCanvasEl: HTMLCanvasElement | null = null;
let dlSwappedEl: HTMLAnchorElement | null = null;
let dlLogEl: HTMLAnchorElement | null = null;

let currentImage: HTMLImageElement | null = null;
let swapCtx: CanvasRenderingContext2D | null = null;
let logCtx: CanvasRenderingContext2D | null = null;
---

<style>
  * { box-sizing: border-box; }
  .component {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #0f172a;
    color: #f8fafc;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
  }
  h1 { margin-top: 0; font-size: 1.8rem; }
  p { color: #94a3b8; margin-bottom: 24px; text-align: center; max-width: 650px; }
  
  .controls {
    background: #1e293b;
    padding: 16px 24px;
    border-radius: 12px;
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 24px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
  }
  
  input[type="file"] { display: none; }
  .btn {
    background: #3b82f6;
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    border: none;
    transition: background 0.2s;
  }
  .btn:hover { background: #2563eb; }
  
  select, input[type="range"] {
    background: #334155;
    color: white;
    border: 1px solid #475569;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 0.9rem;
  }

  .value-badge {
    background: #0f172a;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: monospace;
    color: #38bdf8;
    font-weight: bold;
  }

  .drop-zone {
    width: 100%;
    max-width: 900px;
    border: 2px dashed #475569;
    border-radius: 12px;
    padding: 32px;
    text-align: center;
    color: #94a3b8;
    cursor: pointer;
    margin-bottom: 24px;
    transition: border-color 0.2s;
  }
  .drop-zone:hover { border-color: #3b82f6; }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 1200px;
    margin-bottom: 24px;
  }
  
  .full-width-card {
    width: 100%;
    max-width: 1200px;
  }

  .card {
    background: #1e293b;
    padding: 16px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
  }

  .card h3 { margin: 0; font-size: 1.1rem; color: #cbd5e1; }
  .card .desc { font-size: 0.82rem; color: #64748b; margin-top: 4px; }
  
  canvas, img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    background: #020617;
    image-rendering: pixelated;
  }

  .dl-btn {
    background: #10b981;
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    display: none;
  }
  .dl-btn:hover { background: #059669; }
</style>

<h1>Custom Distance Pixel Swap & Log Transform</h1>
<p>Rearrange pixels across custom distances <span class="value-badge">K ∈ [2, 50]</span>, followed by a logarithmic intensity transformation.</p>

<div class="controls">
  <label class="btn" for="fileInput">Choose Image</label>
  <input type="file" id="fileInput" accept="image/*">
  
  <div class="control-group">
    <label for="swapDist">Distance (K):</label>
    <input type="range" id="swapDist" min="2" max="50" step="1" value="2">
    <span class="value-badge" id="distVal">2 px</span>
  </div>

  <div class="control-group">
    <label for="swapPattern">Pattern:</label>
    <select id="swapPattern">
      <option value="reverse">Invert Block [A, B, C → C, B, A]</option>
      <option value="shift">Cyclic Shift [A, B, C → C, A, B]</option>
      <option value="jump">Jump Swap [A ↔ End of block]</option>
    </select>
  </div>

  <div class="control-group">
    <label for="swapMode">Direction:</label>
    <select id="swapMode">
      <option value="horizontal">Horizontal</option>
      <option value="vertical">Vertical</option>
      <option value="both">2D Block Grid</option>
    </select>
  </div>

  <div class="control-group">
    <label for="logScale">Log Scale (c):</label>
    <input type="range" id="logScale" min="0.1" max="5.0" step="0.1" value="1.0">
    <span class="value-badge" id="scaleVal">1.0x</span>
  </div>
</div>

<div class="drop-zone" id="dropZone">
  Drop image here or click "Choose Image" above
</div>

<!-- Row 1: Original vs Swapped -->
<div class="preview-grid">
  <div class="card">
    <div class="card-header">
      <h3>1. Original Image</h3>
    </div>
    <img id="originalView" alt="Original image preview will appear here">
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h3>2. Rearranged Pixels</h3>
        <div class="desc" id="swapDesc">Step distance: 2 px</div>
      </div>
      <a id="dlSwapped" class="dl-btn">Download</a>
    </div>
    <canvas id="swapCanvas"></canvas>
  </div>
</div>

<!-- Row 2: Log Transformation -->
<div class="full-width-card">
  <div class="card">
    <div class="card-header">
      <div>
        <h3>3. Logarithmic Transformation (s = c · ln(1 + r))</h3>
        <div class="desc">Applied onto the transformed pixel result</div>
      </div>
      <a id="dlLog" class="dl-btn">Download</a>
    </div>
    <canvas id="logCanvas"></canvas>
  </div>
</div>

<script>
  const fileInput = document.getElementById('fileInput');
  const dropZone = document.getElementById('dropZone');
  const swapDist = document.getElementById('swapDist');
  const distVal = document.getElementById('distVal');
  const swapPattern = document.getElementById('swapPattern');
  const swapMode = document.getElementById('swapMode');
  const logScale = document.getElementById('logScale');
  const scaleVal = document.getElementById('scaleVal');
  const swapDesc = document.getElementById('swapDesc');
  
  const originalView = document.getElementById('originalView');
  const swapCanvas = document.getElementById('swapCanvas');
  const logCanvas = document.getElementById('logCanvas');
  
  const dlSwapped = document.getElementById('dlSwapped');
  const dlLog = document.getElementById('dlLog');

  let currentImage = null;

  fileInput.addEventListener('change', (e) => loadFile(e.target.files[0]));
  swapMode.addEventListener('change', () => { if (currentImage) runPipeline(); });
  swapPattern.addEventListener('change', () => { if (currentImage) runPipeline(); });
  
  swapDist.addEventListener('input', (e) => {
    distVal.textContent = e.target.value + ' px';
    if (currentImage) runPipeline();
  });

  logScale.addEventListener('input', (e) => {
    scaleVal.textContent = parseFloat(e.target.value).toFixed(1) + 'x';
    if (currentImage) runPipeline();
  });

  // Drag & drop handlers
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.style.borderColor = '#3b82f6'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = '#475569'; });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.style.borderColor = '#475569';
    if (e.dataTransfer.files.length) loadFile(e.dataTransfer.files[0]);
  });
  dropZone.addEventListener('click', () => fileInput.click());

  function loadFile(file) {
    if (!file || !file.type.startsWith('image/')) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        currentImage = img;
        originalView.src = img.src;
        runPipeline();
        dropZone.style.display = 'none';
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function runPipeline() {
    const w = currentImage.naturalWidth;
    const h = currentImage.naturalHeight;
    const k = parseInt(swapDist.value, 10);
    const pattern = swapPattern.value;
    const mode = swapMode.value;

    swapDesc.textContent = `Distance: ${k}px | Pattern: ${pattern} | Direction: ${mode}`;

    // Set canvas dimensions
    swapCanvas.width = w;
    swapCanvas.height = h;
    logCanvas.width = w;
    logCanvas.height = h;

    const swapCtx = swapCanvas.getContext('2d');
    swapCtx.drawImage(currentImage, 0, 0);

    const swappedImgData = swapCtx.getImageData(0, 0, w, h);
    const data = swappedImgData.data;

    // STEP 1: Custom Distance Pixel Rearrangement
    if (mode === 'horizontal') {
      for (let y = 0; y < h; y++) {
        for (let x = 0; x <= w - k; x += k) {
          applyPatternToLine(data, y * w + x, 1, k, pattern);
        }
      }
    } else if (mode === 'vertical') {
      for (let x = 0; x < w; x++) {
        for (let y = 0; y <= h - k; y += k) {
          applyPatternToLine(data, y * w + x, w, k, pattern);
        }
      }
    } else if (mode === 'both') {
      // 2D Block inversion across KxK subgrids
      for (let y = 0; y <= h - k; y += k) {
        for (let x = 0; x <= w - k; x += k) {
          for (let i = 0; i < k; i++) {
            applyPatternToLine(data, (y + i) * w + x, 1, k, pattern);
          }
        }
      }
    }

    swapCtx.putImageData(swappedImgData, 0, 0);

    // STEP 2: Logarithmic Transformation s = c * ln(1 + r)
    const logCtx = logCanvas.getContext('2d');
    const logImgData = logCtx.createImageData(w, h);
    const logData = logImgData.data;

    const scale = parseFloat(logScale.value);
    const c = (255 / Math.log(1 + 255)) * scale;

    for (let i = 0; i < data.length; i += 4) {
      logData[i]     = Math.min(255, Math.max(0, c * Math.log(1 + data[i])));     // R
      logData[i + 1] = Math.min(255, Math.max(0, c * Math.log(1 + data[i + 1]))); // G
      logData[i + 2] = Math.min(255, Math.max(0, c * Math.log(1 + data[i + 2]))); // B
      logData[i + 3] = data[i + 3];                                              // Alpha
    }

    logCtx.putImageData(logImgData, 0, 0);

    // Download links
    dlSwapped.href = swapCanvas.toDataURL('image/png');
    dlSwapped.download = `pixel_shift_K${k}_${pattern}.png`;
    dlSwapped.style.display = 'inline-block';

    dlLog.href = logCanvas.toDataURL('image/png');
    dlLog.download = `pixel_shift_K${k}_log_transformed.png`;
    dlLog.style.display = 'inline-block';
  }

  // Helper: processes a sequence of K pixels starting at startIdx with stride step
  function applyPatternToLine(data, startPixelIdx, stride, k, pattern) {
    if (pattern === 'reverse') {
      // Invert array segment: [A, B, C, D] -> [D, C, B, A]
      for (let i = 0; i < Math.floor(k / 2); i++) {
        let pA = (startPixelIdx + i * stride) * 4;
        let pB = (startPixelIdx + (k - 1 - i) * stride) * 4;
        swapPixels(data, pA, pB);
      }
    } else if (pattern === 'jump') {
      // Swap endpoints of K range: A <-> End
      let pA = startPixelIdx * 4;
      let pB = (startPixelIdx + (k - 1) * stride) * 4;
      swapPixels(data, pA, pB);
    } else if (pattern === 'shift') {
      // Cyclic right-shift by 1 position within block of K
      let lastPx = (startPixelIdx + (k - 1) * stride) * 4;
      let temp = [data[lastPx], data[lastPx+1], data[lastPx+2], data[lastPx+3]];
      for (let i = k - 1; i > 0; i--) {
        let curr = (startPixelIdx + i * stride) * 4;
        let prev = (startPixelIdx + (i - 1) * stride) * 4;
        data[curr]   = data[prev];
        data[curr+1] = data[prev+1];
        data[curr+2] = data[prev+2];
        data[curr+3] = data[prev+3];
      }
      let firstPx = startPixelIdx * 4;
      data[firstPx]   = temp[0];
      data[firstPx+1] = temp[1];
      data[firstPx+2] = temp[2];
      data[firstPx+3] = temp[3];
    }
  }

  function swapPixels(arr, idxA, idxB) {
    for (let c = 0; c < 4; c++) {
      let temp = arr[idxA + c];
      arr[idxA + c] = arr[idxB + c];
      arr[idxB + c] = temp;
    }
  }
</script>
